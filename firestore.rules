rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'uKTUIiuS3rQcRcmFLhliufbOcds1'; }
    match /manuals/{manualId} {
      allow get, list: if signedIn();
      allow create: if admin() && request.resource.data.active == true
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.storagePath == 'manuals/' + manualId + '.pdf';
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','withdrawnAt'])
        && request.resource.data.active == false;
      allow delete: if false;
    }
  }
}
