rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (request.auth.uid == '1Z9zzNkV2mZW2IS8rakS8UBSkky1' || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    match /manuals/{manualFile} {
      allow read: if signedIn();
      allow create: if admin() && manualFile.matches('[a-f0-9-]{36}\\.pdf')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
  }
}
