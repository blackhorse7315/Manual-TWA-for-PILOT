rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /manuals/{manualFile} {
      // Public download, but no public folder listing. Requires conscious authorization
      // to distribute PDFs and supplementary material to anyone with the app link.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == 'uKTUIiuS3rQcRcmFLhliufbOcds1'
        && manualFile.matches('[a-f0-9-]{36}\\.pdf')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
